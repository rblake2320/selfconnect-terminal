{
  "name": "selfconnect-terminal",
  "version": "3.0.0-rc.1",
  "description": "Everyday SelfConnect desktop terminal with a real PTY, saved history, on-demand Jev triage and a separate governed tool API.",
  "author": "SelfConnect",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "bin": {
    "selfconnect": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./contracts": {
      "types": "./dist/shared/contracts.d.ts",
      "default": "./dist/shared/contracts.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build": "npm run build:renderer && npm run build:electron && npm run build:cli",
    "build:preview": "SELFCONNECT_PREVIEW=1 vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline:local": "node scripts/local-model-baseline.cjs",
    "chat:local": "node scripts/local-model-visible-chat.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:local": "npm run build && electron-builder --config electron-builder.yml --config.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "44.4.3",
    "electron-builder": "^24.13.3",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.16",
    "vite-plugin-electron": "^0.28.7",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
